{
  "$schema": "https://biomejs.dev/schemas/2.4.10/schema.json",
  "formatter": {
    "enabled": true,
    "lineWidth": 120,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedImports": "error"
      },
      "style": {
        "useThrowOnlyError": "error",
        "useForOf": "off",
        "noInferrableTypes": "off",
        "noCommonJs": "error"
      },
      "suspicious": {
        "noEmptyBlockStatements": "error",
        "noConsole": "off"
      },
      "performance": {
        "noDelete": "error"
      },
      "nursery": {
        "noFloatingPromises": "error",
        "useAwaitThenable": "warn",
        "noUnnecessaryConditions": "warn",
        "useNullishCoalescing": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "trailingCommas": "all",
      "semicolons": "always",
      "arrowParentheses": "always",
      "bracketSpacing": true
    }
  },
  "css": {
    "formatter": {
      "enabled": true,
      "quoteStyle": "single",
      "indentStyle": "space",
      "indentWidth": 2,
      "lineWidth": 120,
      "lineEnding": "lf"
    }
  },
  "html": {
    "formatter": {
      "enabled": true,
      "indentStyle": "space",
      "indentWidth": 2,
      "lineWidth": 120,
      "lineEnding": "lf",
      "whitespaceSensitivity": "css",
      "attributePosition": "auto"
    }
  }
}
